{
  "expo": {
    "name": "PILOTIX",
    "slug": "PILOTIX",
    "scheme": "PILOTIX",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a68455bb-25ec-44d4-b75e-517b170f0636"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pilotix.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "package": "com.pilotix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "navigationBar": {
        "visible": "transparent"
      },
      "statusBar": {
        "translucent": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "PILOTIX a besoin d'accéder à votre caméra pour prendre des photos de produits."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PILOTIX accède à votre galerie pour ajouter des photos de produits.",
          "cameraPermission": "PILOTIX a besoin de la caméra pour photographier vos produits.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a68455bb-25ec-44d4-b75e-517b170f0636"
      }
    }
  }
}